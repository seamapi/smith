{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@seamapi/smith": ["./src/index.ts"],
      "lib/*": ["./src/lib/*"]
    }
  },
  "files": ["src/index.ts", "src/eslint-config.ts"],
  "include": [
    "src/**/*",
    "test/**/*",
    "examples/**/*",
    "eslint.config.ts",
    "tsup.config.ts"
  ]
}
