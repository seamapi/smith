{
  "name": "@seamapi/smith",
  "version": "0.4.4",
  "description": "Metalsmith wrapper for Seam API code and doc generation.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./eslint": {
      "import": {
        "types": "./eslint.d.ts",
        "default": "./eslint.js"
      },
      "require": {
        "types": "./dist/eslint.d.cts",
        "default": "./dist/eslint.cjs"
      }
    }
  },
  "module": "index.js",
  "sideEffects": false,
  "keywords": [
    "node"
  ],
  "homepage": "https://github.com/seamapi/smith",
  "bugs": "https://github.com/seamapi/smith/issues",
  "repository": "seamapi/smith",
  "license": "MIT",
  "author": {
    "name": "Seam Labs, Inc.",
    "email": "devops@getseam.com"
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "eslint.js",
    "eslint.js.map",
    "eslint.d.ts",
    "lib",
    "src",
    "dist",
    "tsconfig.base.json",
    "!**/*.test.ts"
  ],
  "scripts": {
    "build": "npm run build:entrypoints",
    "postbuild": "concurrently --raw --group 'node ./index.js' 'node ./eslint.js'",
    "build:entrypoints": "npm run build:ts",
    "postbuild:entrypoints": "tsup",
    "build:ts": "tsc --project tsconfig.build.json",
    "prebuild:ts": "del 'index.*' 'eslint.js*' lib",
    "postbuild:ts": "tsc-alias --project tsconfig.build.json",
    "typecheck": "tsc",
    "test": "c8 ava",
    "pretest": "concurrently --raw --group 'tsx src/index.ts' 'tsx src/eslint.ts'",
    "test:update": "ava --update-snapshots",
    "test:watch": "ava --watch",
    "test:debug": "ava debug --break",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore .",
    "postversion": "git push --follow-tags",
    "example": "tsx examples",
    "example:inspect": "tsx --inspect examples",
    "format": "prettier --write --ignore-path .gitignore .",
    "preformat": "eslint --fix .",
    "report": "c8 report"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.1.0"
  },
  "peerDependencies": {
    "@metalsmith/layouts": "^2.7.0",
    "@seamapi/blueprint": ">=0.43.1",
    "del": "^8.0.0",
    "eslint": "^9.31.0",
    "jiti": "^2.0.0",
    "jstransformer-handlebars": "^1.2.0",
    "metalsmith": "^2.6.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.0.0",
    "tsx": "^4.6.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/node": "^22.15.21",
    "change-case": "^5.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^11.0.2",
    "neostandard": "^0.12.2"
  },
  "devDependencies": {
    "@metalsmith/layouts": "^2.7.0",
    "@seamapi/blueprint": "^0.43.1",
    "@seamapi/types": "^1.402.0",
    "@swc/core": "^1.11.29",
    "ava": "^6.0.1",
    "c8": "^10.1.2",
    "concurrently": "^9.1.2",
    "del": "^8.0.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.31.0",
    "jiti": "^2.4.2",
    "jstransformer-handlebars": "^1.2.0",
    "landlubber": "^2.0.0",
    "metalsmith": "^2.6.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.0.0",
    "tsc-alias": "^1.8.2",
    "tsup": "^8.0.1",
    "tsx": "^4.6.2",
    "typescript": "^5.8.3"
  }
}
