{
  "name": "@seamapi/smith",
  "version": "1.0.0",
  "description": "Metalsmith wrapper for Seam API code and doc generation.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./eslint-config": {
      "import": {
        "types": "./eslint-config.d.ts",
        "default": "./eslint-config.js"
      }
    }
  },
  "module": "index.js",
  "sideEffects": false,
  "keywords": [
    "node"
  ],
  "homepage": "https://github.com/seamapi/smith",
  "bugs": "https://github.com/seamapi/smith/issues",
  "repository": "seamapi/smith",
  "license": "MIT",
  "author": {
    "name": "Seam Labs, Inc.",
    "email": "devops@getseam.com"
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "eslint-config.js",
    "eslint-config.js.map",
    "eslint-config.d.ts",
    "lib",
    "src",
    "tsconfig.base.json",
    "!test",
    "!**/*.test.ts"
  ],
  "scripts": {
    "build": "npm run build:entrypoints",
    "postbuild": "concurrently --raw --group 'node ./index.js' 'node ./eslint-config.js'",
    "build:entrypoints": "npm run build:ts",
    "build:ts": "tsc --project tsconfig.build.json",
    "prebuild:ts": "del 'index.*' 'eslint-config.*' lib",
    "postbuild:ts": "tsc-alias --project tsconfig.build.json",
    "typecheck": "tsc",
    "test": "c8 ava",
    "pretest": "concurrently --raw --group 'tsx src/index.ts' 'tsx src/eslint-config.ts'",
    "test:update": "ava --update-snapshots",
    "test:watch": "ava --watch",
    "test:debug": "ava debug --break",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore .",
    "postversion": "git push --follow-tags",
    "example": "tsx examples",
    "example:inspect": "tsx --inspect examples",
    "format": "prettier --write --ignore-path .gitignore .",
    "preformat": "eslint --fix .",
    "report": "c8 report"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || ^22.11.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0 || ^10.9.4"
    }
  },
  "peerDependencies": {
    "@metalsmith/layouts": "^2.7.0",
    "@seamapi/blueprint": ">=0.51.3",
    "del": "^8.0.0",
    "eslint": "^9.31.0",
    "jiti": "^2.0.0",
    "jstransformer-handlebars": "^1.2.0",
    "metalsmith": "^2.6.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.0.0",
    "tsx": "^4.6.2",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@types/node": "^24.10.9",
    "change-case": "^5.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^13.0.6",
    "neostandard": "^0.13.0"
  },
  "devDependencies": {
    "@metalsmith/layouts": "^2.7.0",
    "@seamapi/blueprint": "^1.0.0",
    "@seamapi/types": "^1.540.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "concurrently": "^9.1.2",
    "del": "^8.0.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.31.0",
    "jiti": "^2.4.2",
    "jstransformer-handlebars": "^1.2.0",
    "landlubber": "^2.0.0",
    "metalsmith": "^2.6.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.0.0",
    "tsc-alias": "^1.8.2",
    "tsx": "^4.6.2",
    "typescript": "^6.0.3"
  }
}
