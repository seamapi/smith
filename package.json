{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@seamapi/smith",
  "version": "1.2.1",
  "description": "Metalsmith wrapper for Seam API code and doc generation.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./eslint-config": {
      "types": "./eslint-config.d.ts",
      "default": "./eslint-config.js"
    }
  },
  "module": "index.js",
  "sideEffects": false,
  "keywords": [
    "node"
  ],
  "homepage": "https://github.com/seamapi/smith",
  "bugs": "https://github.com/seamapi/smith/issues",
  "repository": "seamapi/smith",
  "license": "MIT",
  "author": {
    "name": "Seam Labs, Inc.",
    "email": "devops@getseam.com"
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "eslint-config.js",
    "eslint-config.js.map",
    "eslint-config.d.ts",
    "lib",
    "src",
    "tsconfig.base.json",
    "!test",
    "!**/*.test.ts"
  ],
  "scripts": {
    "build": "npm run build:entrypoints",
    "postbuild": "concurrently --raw --group 'node ./index.js' 'node ./eslint-config.js'",
    "build:entrypoints": "npm run build:ts",
    "build:ts": "tsc --project tsconfig.build.json",
    "prebuild:ts": "del 'index.*' 'eslint-config.*' lib",
    "postbuild:ts": "tsc-alias --project tsconfig.build.json",
    "typecheck": "tsc",
    "test": "ava",
    "pretest": "concurrently --raw --group 'tsx src/index.ts' 'node --experimental-strip-types src/eslint-config.ts'",
    "test:update": "ava --update-snapshots",
    "test:watch": "ava --watch",
    "test:debug": "ava debug --break",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore .",
    "postversion": "git push --follow-tags",
    "example": "tsx examples",
    "example:inspect": "tsx --inspect examples",
    "format": "prettier --write --ignore-path .gitignore .",
    "preformat": "eslint --fix ."
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0 || ^24.12.0 || ^22.20.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0 || ^10.9.4"
    }
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "peerDependencies": {
    "@metalsmith/layouts": "^2.7.0",
    "@seamapi/blueprint": ">=0.51.3",
    "del": "^8.0.0",
    "eslint": "^9.31.0 || ^10.0.0",
    "jiti": "^2.0.0",
    "jstransformer-handlebars": "^1.2.0",
    "metalsmith": "^2.6.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.0.0",
    "tsx": "^4.6.2",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "change-case": "^5.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^14.0.2",
    "neostandard": "^0.14.1"
  },
  "devDependencies": {
    "@metalsmith/layouts": "^2.7.0",
    "@seamapi/blueprint": "^1.13.2",
    "@seamapi/types": "^1.540.0",
    "ava": "^8.0.1",
    "concurrently": "^9.1.2",
    "del": "^8.0.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jiti": "^2.4.2",
    "jstransformer-handlebars": "^1.2.0",
    "landlubber": "^2.0.0",
    "metalsmith": "^2.6.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.0.0",
    "tsc-alias": "^1.8.2",
    "tsx": "^4.6.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "gray-matter": {
      "js-yaml": "^3.15.2"
    },
    "supertap": {
      "js-yaml": "^3.15.2"
    },
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.2"
    }
  }
}
